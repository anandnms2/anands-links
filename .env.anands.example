# generate secrets with: openssl rand -base64 32
POSTGRES_PASSWORD=
MEILI_MASTER_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://links.anands.xyz/api/v1/auth

# Authentik: create an OAuth2/OpenID provider + application with slug "anands-links"
# Redirect URI (strict): https://links.anands.xyz/api/v1/auth/callback/authentik
# Scopes: openid, email, profile
AUTHENTIK_ISSUER=https://sso.anands.xyz/application/o/anands-links
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
DISABLE_REGISTRATION=false
LINKS_PORT=3000
